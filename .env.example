# ---------------------------------------------------------------------------
# FitPal configuration
# Copy this file to `.env` and fill in your Azure OpenAI details.
# These run on the SERVER only — the key is never shipped to the browser.
# ---------------------------------------------------------------------------

# Azure OpenAI endpoint, e.g. https://your-resource-name.openai.azure.com
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com

# Your Azure OpenAI API key
AZURE_OPENAI_KEY=your_azure_openai_key_here

# Your deployment name (usually "gpt-4o" or similar)
AZURE_OPENAI_DEPLOYMENT=gpt-4o

# API version (optional — defaults to a recent preview if omitted)
AZURE_OPENAI_API_VERSION=2024-08-01-preview

# Port the server listens on (optional, default 3001)
# PORT=3001
