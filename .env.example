# FitPal configuration — copy to `.env`. Server-side only; keys never reach the browser.
# FitPal uses one generic AI config that works with any OpenAI-compatible API
# (OpenAI, LiteLLM, OpenRouter, Ollama, vLLM, …). All three are required.
AI_API_KEY=your-key-here  # any non-empty value for local Ollama
AI_BASE_URL=https://api.openai.com/v1  # OpenRouter: https://openrouter.ai/api/v1 · Ollama: http://localhost:11434/v1
AI_MODEL=gpt-4o-mini  # model id, e.g. claude-3-5-sonnet, llama3

# --- To use Azure OpenAI instead, set AI_PROVIDER=azure and use these meanings:
# AI_BASE_URL=<your resource endpoint> # e.g. https://your-resource.openai.azure.com
# AI_MODEL=<your deployment name>
AI_PROVIDER=azure
AI_API_VERSION=2024-08-01-preview        # required when AI_PROVIDER=azure

# Secret used to sign auth session JWTs (httpOnly cookie). REQUIRED — the server
# refuses to start without it. Use a long random string (min 16 chars), e.g.
# `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`.
JWT_SECRET=change-me-to-a-long-random-secret

# Port the storage/API server listens on (read by the server at runtime).
# PORT=3001   # optional, default 3001

# Logging. Structured (newline-delimited JSON) request/error logs with a
# per-request correlation id (also echoed on the X-Request-Id response header).
# LOG_LEVEL=info            # debug | info | warn | error (default info)
# LOG_PRETTY=1              # human-readable single-line logs (default: on in dev)

# Base URL the frontend uses to reach the API. Inlined into the build at compile
# time (must be VITE_-prefixed to be exposed to the browser). Defaults to the
# relative path "/api", which works for the single-origin dev proxy and the
# single-process production build. Set this only for split deployments where the
# frontend and server live on different origins.
# VITE_API_URL=http://localhost:3001/api
