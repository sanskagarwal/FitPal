# Azure OpenAI Configuration
# Get these values from your Azure OpenAI resource in Azure Portal

# Example: https://your-resource-name.openai.azure.com
VITE_AZURE_OPENAI_ENDPOINT=your_azure_openai_endpoint_here

# Your Azure OpenAI API key
VITE_AZURE_OPENAI_KEY=your_azure_openai_key_here

# Your deployment name (usually "gpt-4o" or similar)
VITE_AZURE_OPENAI_DEPLOYMENT=gpt-4o

# API Configuration
VITE_API_URL=http://localhost:3001/api

# Credentials for development (will be ignored in production)
FITPAL_EMAIL=example@abc.com

FITPAL_PASSWORD=password
